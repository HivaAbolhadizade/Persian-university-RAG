# Project root is auto-detected when backend/ is inside University_RAG.
UNIVERSITY_RAG_ROOT=

ENVIRONMENT=development
DEBUG=false

# Use the same hostname in the frontend and backend. Recommended: 127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:5173,http://localhost:4173
TRUSTED_HOSTS=127.0.0.1,localhost,testserver

SESSION_COOKIE_NAME=university_rag_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict

# The UI can configure OpenAI/Gemini at runtime. Mock is the safe initial default.
LLM_PROVIDER=mock
ALLOW_MOCK_FALLBACK=false

# Optional fallback values. Normally leave blank and use the Settings page.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

DEFAULT_TOP_K=5
MAXIMUM_TOP_K=10
USE_RETRIEVAL_THRESHOLD=true
USE_RERANKER=true

ENABLE_DOCUMENT_UPLOAD=true
MAXIMUM_UPLOAD_MB=40

# Disabled by default because it executes Notebook 01 and Notebook 02.
ENABLE_INDEX_REBUILD=false
REBUILD_NOTEBOOK_01=notebooks/01_Data_Preparation.ipynb
REBUILD_NOTEBOOK_02=notebooks/02_Retrieval_Pipeline.ipynb
